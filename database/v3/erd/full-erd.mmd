    }
    repair_tests {
        uuid content_version_id FK,PK "이 기록에 적용한 정확한 콘텐츠 버전"
        text test_key PK "해당 버전 안의 작업대 시험 키"
        text title  "표시 제목"
        text__ dependent_controls  "설정 변경 시 이 시험을 무효화할 설정 키 목록"
        text pass_text  "시험 성공 안내"
        text fail_text  "시험 실패 안내"
        int display_order  "같은 버전 안의 표시 순서"
    }
    repair_trials {
        uuid id PK "행 고유 식별자"
        uuid run_id FK "이 기록이 속한 수리 도전"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        text test_key FK "해당 버전 안의 작업대 시험 키"
