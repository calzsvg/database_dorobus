erDiagram
    %% v3: 수리 완료는 도전 필수. 비수리 완료의 도전은 NULL. 조건부 필수성은 SQL CHECK/FK 참조.
    assignments {
        uuid id PK "과제 배정 고유 번호"
        uuid class_group_id FK "과제를 받은 반"
        uuid content_version_id FK "출제한 문제의 정확한 버전"
        date assigned_on  "과제 출제일. 현재 ASSIGN의 날짜에 대응"
        timestamptz due_at  "마감 시각. 마감이 없으면 비워 둠"
        int sort_order  "과제 목록 표시 순서. 작은 숫자를 먼저 표시"
    }
    cell_transactions {
        uuid id PK "거래 내역 고유 번호"
        uuid user_id FK "잔액이 바뀐 사용자"
        bigint amount  "CELL 증감량. 보상 +50, 가구 구매 -200"
        varchar_50_ reason  "발생 사유 코드. 예: content_reward, item_purchase, migration_opening"
        uuid operation_id  "서버가 처리하는 업무 한 건의 식별자. 같은 요청 재처리 시 재사용"
        timestamptz created_at  "거래를 기록한 시각"
    }
    class_groups {
        uuid id PK "반 고유 번호"
        uuid course_id FK "이 반이 사용하는 교육 과정"
        uuid teacher_id FK "담당 강사의 사용자 번호"
        varchar_100_ name  "반 이름. 예: K-POP 월요일 A반"
        date starts_on  "수업 운영 시작일"
        date ends_on  "운영 종료일. 미정이면 비워 둠"
        varchar_20_ status  "planned 준비 중 / active 운영 중 / completed 종료 / cancelled 취소"
    }
    content_completions {
        uuid user_id FK,PK "문제를 완료한 사용자"
        uuid content_id FK,PK "완료한 문제. 수업별이 아닌 문제 자체를 가리킴"
        uuid completed_version_id FK "최초 완료할 때 풀었던 문제 버전"
        timestamptz completed_at  "최초 완료를 확정한 시각"
        uuid source_repair_run_id FK "수리일 때 본인의 동일 콘텐츠·버전 completed 도전 필수. 비수리일 때 NULL. 실제 종류 FK·NOT NULL·CHECK·완료 FK가 함께 보"
        varchar_30_ content_kind FK "필수 콘텐츠 종류. contents(id,kind) 복합 FK로 실제 정의와 일치. 수리는 완료 도전 필수, 비수리는 도전 없이 기록"
        text source_phase FK "도전이 있으면 자동 completed. 수리는 별도 종류 FK·NOT NULL·CHECK가 NULL 도전 우회를 차단하며 강한 FK가 소유자·콘텐츠·버전"
    }
    content_versions {
        uuid id PK "특정 문제 버전의 고유 번호"
        uuid content_id FK "원래 어떤 문제의 버전인지"
        int version  "버전 번호. 첫 버전은 1. 같은 문제 안에서 순서대로 부여"
        varchar_200_ title  "해당 버전의 문제 제목"
        jsonb public_body  "공개 질문·보기·작업대 설정. 정답과 미관찰 사실은 제외"
        jsonb grading_rule  "정답·판정 자료 JSON. 서버 전용이며 브라우저에 전달 금지"
        timestamptz published_at  "공개 시각. NULL이면 작성 중인 버전"
    }
    contents {
        uuid id PK "문제·활동 고유 번호"
        varchar_100_ code  "코드상의 고정 식별자. 예: q-sensor, w-condition"
        varchar_30_ kind  "quiz / world(독립 월드 문제) / homework / coding_challenge / repair_case. 본편 스토리 유형 제외"
        varchar_30_ concept  "학습 개념. 예: sensor 센서, condition 조건. 해당 없으면 비워 둠"
        bool is_active  "새 출제에 사용할 수 있는 활동인지"
    }
    courses {
        uuid id PK "교육 과정 고유 번호"
        varchar_50_ code  "코드에서 사용하는 고정 이름. 예: l1"
        varchar_200_ title  "과정명. 예: AI K-POP 프로듀싱 작전"
        varchar_20_ track  "과정 계열. spark 또는 awake"
        smallint level  "현재 프로그램의 교육 레벨. 1~8"
        text description  "과정의 자세한 소개"
        jsonb display_meta  "과정 소개용 아이콘·미션 문구·도구·키트·결과물 안내 묶음"
        bool is_active  "새로 제공할 수 있는 과정인지. false라도 과거 기록은 유지"
    }
    driving_licenses {
        uuid user_id FK,PK "면허 소유 사용자. 한 사람당 하나"
        uuid source_run_id FK "면허를 발급한 본인의 완료된 도입 사건. 복합 FK가 소유자·유형·완료 상태를 검사"
        text source_case_role FK "자동 계산 onboarding. 임의 다른 사건으로 면허 발급 불가"
        text source_phase FK "자동 계산 completed. 미완료 자동차로 면허 발급 불가"
        timestamptz issued_at  "서버가 확정한 자동차 완료 시각"
        uuid request_id  "최초 발급 요청. 재전송/재도전에서 면허를 중복 발급하지 않음"
        timestamptz recorded_at  "면허 행을 등록한 시각"
    }
    enrollments {
        uuid id PK "수강 기록 고유 번호"
        uuid user_id FK "수강하는 학생"
        uuid class_group_id FK "수강하는 반"
        varchar_20_ status  "active 수강 중 / completed 수료 / withdrawn 중도 취소"
        timestamptz enrolled_at  "수강 등록 시각"
        timestamptz completed_at  "수료 시각. 수강 중·중도 취소이면 비워 둠"
    }
    items {
        uuid id PK "가구 종류 고유 번호"
        varchar_50_ code  "기존 화면·3D 모델과 연결할 고정 이름. 예: plant"
        varchar_100_ name  "상품 이름. 예: 몬스테라 화분"
        text description  "상품 소개 문구"
        bigint price_cell  "현재 판매 가격. 예: 200"
        jsonb display_meta  "표시 색상·아이콘·모델 연결 키 등. 예: {'color':'#4CAF6E'}"
        bool is_active  "판매 중인지. 판매 중단해도 기존 보유 기록은 유지"
    }
    learning_attempts {
        uuid id PK "제출 기록 고유 번호"
        uuid user_id FK "답안을 제출한 사용자"
        uuid content_version_id FK "실제로 푼 문제 버전"
        uuid assignment_id FK "어느 과제를 보고 풀었는지. 독립적으로 풀면 비워 둠"
        varchar_100_ step_key  "여러 단계 중 답변한 단계의 고정 이름. 예: step-1"
        varchar_20_ scope  "step은 단계 답변, activity는 전체 활동 답안"
        jsonb answer  "학생이 제출한 보기 ID·순서·블록 목록 등. 예: {'option_id':'light'}"
        bool is_correct  "수리에서는 verdict=correct일 때만 true. partial/needs/unclear는 false이지만 모두 오답을 뜻하지 않음"
        timestamptz submitted_at  "서버가 제출을 접수한 시각"
        uuid request_id  "같은 제출 요청의 재전송을 식별하는 번호. 재시도 때 같은 값을 재사용"
        uuid repair_run_id FK "수리 제출일 때 해당 도전. 독립 교육 제출이면 NULL"
        text repair_case_role FK "도전과 같은 사건 유형. 복합 FK의 일부"
        int attempt_no  "run 안의 제출 순번. 서버가 run 잠금 뒤 발급. request_id와 역할이 다름"
        text verdict  "수리 판정. false인 is_correct를 모두 오답으로 집계하면 안 됨"
        text judge_source  "rule / model / hybrid 판정 경로"
        text rule_version  "적용한 서버 판정 규칙 버전"
        text prompt_version  "모델 판정에 사용한 프롬프트 버전. 미사용 NULL"
        text model_id  "실제 모델 식별자. 미사용 NULL"
        text fallback_reason  "모델 대신 규칙으로 판단한 사유. 해당 없으면 NULL"
        text feedback_text  "해당 제출에 확정된 안내 문구"
        text wrong_hypothesis_code FK "대표 오답 유형. wrong인데 NULL이면 미분류. 원본 규칙/프롬프트 버전과 함께 해석"
        timestamptz answer_redacted_at  "원문 제거 시각. 보관 기간은 아직 미정이며 자동 삭제 작업은 미구현"
    }
    parts {
        uuid id PK "행 고유 식별자"
        text code  "코드와 DB가 함께 쓰는 고정 이름"
        text name  "표시 이름"
    }
    player_profiles {
        uuid user_id FK,PK "설정의 주인인 사용자"
        uuid selected_class_group_id FK "현재 화면에서 선택한 반. 수강 이력 전체를 뜻하지 않음"
        uuid active_world_content_version_id FK "현재 도로랜드에서 수행하려고 선택한 문제 버전"
        uuid goal_item_id FK "구매 목표로 정한 가구"
        jsonb preferences  "보이드 성격·음량 같은 설정. 예: {'robot_persona':'kind'}"
        timestamptz updated_at  "설정을 마지막으로 바꾼 시각"
    }
    repair_attempt_evidence {
        uuid attempt_id FK,PK "연결된 답안 제출"
        uuid run_id FK "이 기록이 속한 수리 도전"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        text clue_key FK,PK "해당 버전 안의 단서 키"
    }
    repair_case_versions {
        uuid content_version_id FK,PK "이 기록에 적용한 정확한 콘텐츠 버전"
        uuid content_id FK "변하지 않는 콘텐츠 식별자"
        varchar_30_ content_kind FK "자동 계산 repair_case. 수리 정의를 비수리 콘텐츠로 위장하거나 NULL로 우회할 수 없도록 실제 contents.kind와 연결"
        text case_role  "onboarding / festival / finale / remote"
        text source_ref  "원본 소스 커밋과 사건 식별자"
        text unlock_part_code FK "최초 완료로 영구 해금하는 부품. 수량 아님"
        text unlock_license_code  "퍼레이드 최초 완료로 얻는 remote_repair 자격"
        jsonb entry_rule  "서버가 검사하는 사건 입장 규칙. 예: min_festival_completions, requires_remote_license. 수업/월드 스토리는 참"
        int reward_cell  "완료 보상 CELL. v3의 9개 사건은 모두 0. 양수 보상을 위한 일반 경로는 유지. 서버만 읽고 결정"
    }
    repair_clue_discoveries {
        uuid run_id FK,PK "이 기록이 속한 수리 도전"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        text clue_key FK,PK "해당 버전 안의 단서 키"
        int discovery_order  "그 도전에서 단서를 처음 확인한 순서"
        timestamptz discovered_at  "단서를 처음 확인한 서버 시각"
        text note_text  "해당 단서에 대한 학생 생각 메모. 사실과 별개"
    }
    repair_clues {
        uuid content_version_id FK,PK "이 기록에 적용한 정확한 콘텐츠 버전"
        text clue_key PK "해당 버전 안의 단서 키"
        text category  "observation 관찰 / question 질문 / inspection 점검 / record 기록"
        text title  "표시 제목"
        text fact_text  "관찰 뒤 학생에게 공개할 단서의 사실 본문"
        text npc_name  "질문 상대 이름. 질문 이외에는 NULL"
        int display_order  "같은 버전 안의 표시 순서"
        text__ unlock_after_keys  "비어 있으면 즉시 표시. 선행 단서 중 하나 이상 확인하면 표시. 도움으로 별도 해금 가능. 같은 버전 키 존재·순환은 발행 검사"
    }
    repair_hint_events {
        uuid id PK "행 고유 식별자"
        uuid run_id FK "이 기록이 속한 수리 도전"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        uuid triggered_by_attempt_id FK "도움을 유발한 답안 제출. 수동 요청이면 NULL 가능"
        uuid request_id  "재전송을 구별하는 요청 UUID. UNIQUE 조합은 아래 명세 참조"
        text trigger_kind  "requested / automatic / judge_feedback"
        text phase  "investigation 조사 / bench 시험 / completed 완료"
        text hint_key  "고정 힌트 식별자. 자유 생성 안내이면 NULL 가능"
        text hint_text  "서버가 확정한 도움 본문"
        text rule_version  "적용한 서버 판정 규칙 버전"
        timestamptz shown_at  "화면의 표시 확인 응답을 받은 시각. 미확인 NULL, 이해도/효과 측정값이 아님"
        text revealed_clue_key FK "이 도움 요청이 미리 연 단서. NULL이면 해금 효과 없는 도움. 재접속 시 이 값을 모아 복원"
        timestamptz issued_at  "서버가 도움 응답을 확정한 시각. 실제로 읽었다는 의미가 아님"
    }
    repair_problem_solutions {
        uuid run_id FK,PK "이 기록이 속한 수리 도전"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        text problem_key FK,PK "해당 버전 안의 원인 문제 키"
        uuid attempt_id FK "연결된 답안 제출"
        timestamptz solved_at  "이 원인을 처음 인정한 시각"
        text accepted_verdict FK "원본 제출의 correct/partial과 일치해야 한다. 해당 원인을 실제로 인정할지는 서버 판정"
    }
    repair_problems {
        uuid content_version_id FK,PK "이 기록에 적용한 정확한 콘텐츠 버전"
        text problem_key PK "해당 버전 안의 원인 문제 키"
        text title  "표시 제목"
        int display_order  "같은 버전 안의 표시 순서"
    }
    repair_runs {
        uuid id PK "행 고유 식별자"
        uuid user_id FK "이 기록의 사용자"
        uuid content_id FK "변하지 않는 콘텐츠 식별자"
        uuid content_version_id FK "이 기록에 적용한 정확한 콘텐츠 버전"
        text case_role FK "onboarding / festival / finale / remote"
        text phase  "investigation 조사 / bench 시험 / completed 완료"
        jsonb settings  "작업대 현재 설정값 JSON. 유효 선택지는 서버 검사"
        int bench_revision  "작업대 설정 변경 순번"
